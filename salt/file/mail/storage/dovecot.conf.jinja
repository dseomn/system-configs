{% from 'common/map.jinja' import common %}
{% from 'crypto/map.jinja' import crypto %}
{% from 'mail/dovecot/map.jinja' import dovecot %}
{% from 'stunnel/map.jinja' import stunnel %}

# The local mail system isn't allowed to send email from any other domains. This
# should be fine for internal notifications, but if this ever needs to support
# sending mail externally, dovecot will need a way to send mail from a different
# address.
postmaster_address = postmaster@{{ grains.id }}

mail_uid = vmail
mail_gid = vmail

mail_driver = maildir
mail_path = \
  /var/local/mail/persistent/mail/%{user | domain}/%{user | username}/Maildir

mailbox_list_storage_escape_char = "\\"

sieve_plugins = sieve_extprograms
sieve_global_extensions {
  vnd.dovecot.filter = yes
}

sieve_filter_bin_dir = {{ dovecot.top_config_dir }}/sieve-filter-bin
# This should be less than lmtp_data_done_timeout in postfix and more than
# --connect-timeout plus --timeout in spamc.
sieve_filter_exec_timeout = 540s

sieve_user_log_path = \
  /var/local/mail/persistent/mail/%{user | domain}/%{user | username}/sieve.log

sieve_script before {
  sieve_script_type = before
  sieve_script_path = {{ dovecot.top_config_dir }}/sieve-before
}

sieve_script personal {
  sieve_script_type = personal
  sieve_script_path = \
    {{ common.local_etc }}/mail/%{user | domain}/%{user | username}/sieve
  sieve_script_active_path = \
    /var/cache/mail/%{user | domain}/%{user | username}/active.sieve
  sieve_script_bin_path = \
    /var/cache/mail/%{user | domain}/%{user | username}/sieve
}

namespace inbox {
  namespace_inbox = yes
  namespace_separator = /
  # https://datatracker.ietf.org/doc/html/rfc9051#section-7.3.1
  mailbox Archive {
    mailbox_special_use = \Archive
  }
  mailbox Drafts {
    mailbox_special_use = \Drafts
  }
  mailbox Junk {
    mailbox_special_use = \Junk
  }
  mailbox Sent {
    mailbox_special_use = \Sent
  }
  mailbox Trash {
    mailbox_special_use = \Trash
  }
}

protocols {
  imap = yes
  lmtp = yes
}

ssl = required
ssl_min_protocol = {{ crypto.openssl.general_protocols_min }}
ssl_cipher_list = {{
    crypto.openssl.ciphers_to_string(crypto.openssl.general_ciphers) }}
ssl_server_key_file = {{ default_certificate.key }}
ssl_server_cert_file = {{ default_certificate.fullchain }}
{%- for certificate_name, certificate in certificates.items() %}
local_name {{ certificate_name }} {
  ssl_server_key_file = {{ certificate.key }}
  ssl_server_cert_file = {{ certificate.fullchain }}
}
{%- endfor %}

# See https://www.dovecot.org/list/dovecot/2018-January/110552.html and
# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=961033#10 for advice about
# letting all users use stats-writer.
service stats {
  unix_listener stats-writer {
    unix_listener_mode = 0666
  }
}

service auth {
  unix_listener auth-userdb {
    unix_listener_mode = 0660
    unix_listener_group = vmail
  }
}

# Despite the name, this appears to work for lmtp too.
lda_mailbox_autosubscribe = yes

protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}

service lmtp {
  service_user = vmail
  unix_listener lmtp {
    unix_listener_mode = 0660
    unix_listener_group = {{ stunnel.group }}
  }
}

service imap-login {
  inet_listener imaps {
    inet_listener_port = 993
    inet_listener_ssl = yes
  }
}
