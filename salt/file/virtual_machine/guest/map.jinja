{#
 # Raises an error if it's not running on a VM guest.
 #}
{% macro require_running_on_vm_guest() %}
  {% if not salt.grains.has_value('role:virtual-machine:guest') %}
    {{ error_this_state_can_only_be_run_from_a_vm }}
  {% endif %}
{% endmacro %}
